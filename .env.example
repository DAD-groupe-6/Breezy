# Variables d'environnement secrètes.
# Copiez ce fichier en `.env` à la racine et renseignez de vraies valeurs.
# Le fichier `.env` n'est jamais commité (voir .gitignore).

# Clé de signature des JWT — DOIT être identique pour tous les services
# qui manipulent les tokens (Auth signe, Post/User vérifient).
JWT_SECRET=change_me_with_a_real_secret
JWT_EXPIRES_IN=1h

# Mot de passe partagé des bases PostgreSQL (Auth & User).
# Doit correspondre entre le conteneur de base et le service qui s'y connecte.
POSTGRES_PASSWORD=change_me

# Secret partagé pour les appels internes service-à-service (bypass des permissions).
INTERNAL_SERVICE_SECRET=change_me_with_a_real_secret
